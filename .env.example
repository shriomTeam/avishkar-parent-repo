# Copy to .env at the repo root.
APP_ENV=dev
# Opt in only for the existing header-based synthetic-data demo. Google sessions are default.
ALLOW_DEV_AUTH=false

# Host port for local Docker Postgres; match this port in the database URLs below.
POSTGRES_PORT=5432

# Migrations run as the schema owner. The API and worker connect as clinic_app,
# a non-owner role, so Postgres row-level security applies to every query.
DATABASE_OWNER_URL=postgresql+psycopg://clinic_owner:clinic_owner@localhost:5432/clinic
DATABASE_URL=postgresql+psycopg://clinic_app:clinic_app@localhost:5432/clinic
DATABASE_SYSTEM_URL=postgresql+psycopg://clinic_system:clinic_system@localhost:5432/clinic

REDIS_URL=redis://localhost:6379

# Next.js -> FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Messaging provider: "console" (logs only) or "twilio"
MESSAGING_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google login: secrets are backend-only. Register this exact callback in Google Console.
DATABASE_AUTH_URL=postgresql+psycopg://clinic_auth:clinic_auth@localhost:5432/clinic
PUBLIC_APP_ORIGIN=http://localhost:3000
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_COOKIE_NAME=avishkar_session
COOKIE_SECURE=false
TRUSTED_HOSTS=["localhost","127.0.0.1","backend"]
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Voice agents call Gemini Live on Vertex AI using Application Default Credentials
# (locally: gcloud auth application-default login; on Cloud Run: the service account).
# Empty project = the one from your credentials.
VOICE_GCP_PROJECT=
VOICE_GCP_LOCATION=us-central1
VOICE_MODEL=gemini-live-2.5-flash-native-audio
VOICE_MAX_CALL_SECONDS=600

# Custom tools: auth headers are stored encrypted with this Fernet key. Optional in dev (a fixed, public key is used),
# required elsewhere. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VOICE_SECRETS_KEY=
# Dev and tests only: let tools call localhost and private addresses. Never set this in production.
VOICE_TOOL_ALLOW_PRIVATE_HOSTS=false

# Behind Cloud Run the API sees every request as coming from Google's front end. Set to 1 there (Terraform does)
# so rate limits count real clients; leave 0 anywhere else, because X-Forwarded-For can be forged.
TRUSTED_PROXY_HOPS=0
