# Copy to .env at the repo root.
APP_ENV=dev

# Migrations run as the schema owner. The API and worker connect as clinic_app,
# a non-owner role, so Postgres row-level security applies to every query.
DATABASE_OWNER_URL=postgresql+psycopg://clinic_owner:clinic_owner@localhost:5432/clinic
DATABASE_URL=postgresql+psycopg://clinic_app:clinic_app@localhost:5432/clinic
DATABASE_SYSTEM_URL=postgresql+psycopg://clinic_system:clinic_system@localhost:5432/clinic

REDIS_URL=redis://localhost:6379

# Next.js -> FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Messaging provider: "console" (logs only) or "twilio"
MESSAGING_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
